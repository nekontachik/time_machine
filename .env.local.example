# AI — Text generation via OpenRouter (required)
# Used for event generation (Gemini 2.0 Flash) and scenario streaming (Claude Sonnet)
OPENROUTER_API_KEY=

# AI — Image + Video generation via fal.ai (required)
# Used for Flux Schnell images and Kling 2.0 video generation
# Get your key at https://fal.ai/dashboard/keys
FAL_KEY=

# Cache + Rate limiting — Redis (optional)
# Events are cached for 24h. Rate limiting tracks per-IP daily usage.
# If not set, caching is disabled and rate limiting is bypassed (fail-open).
REDIS_URL=

# Rate limit — free requests per day per IP (optional, default: 3)
RATE_LIMIT_FREE=3

# Video mock mode (optional, default: false)
# Set to "true" to use simulated video responses even when FAL_KEY is present.
# Useful for testing the UI flow without spending fal.ai credits on Kling 2.0.
MOCK_VIDEO=false

# Tavily — web search enrichment for event context + Wikipedia links (optional)
# Get your key at https://app.tavily.com
TAVILY_API_KEY=

# App URL (optional, default: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Judge model for the eval harness — MUST be a different family than SCENARIO_MODEL
JUDGE_MODEL=google/gemini-3.1-flash-lite
