# AI — Text generation via OpenRouter (required for /api/events and /api/scenario)
OPENROUTER_API_KEY=

# AI — Image generation (required for /api/image)
# OPENAI_API_KEY no longer needed — images use OpenRouter (FLUX.2 Klein)
OPENAI_API_KEY=

# Cache — Redis for events (TTL 24h) + rate limiting
REDIS_URL=

# Payments — Stripe (international)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payments — LiqPay (Ukraine)
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# AI Video — Runway ML (Phase 4, replaced by Kling AI)
RUNWAY_API_KEY=

# AI Video — Kling AI image-to-video (Phase 4, premium feature)
# Obtain from https://app.klingai.com/global/dev or the KIE.ai proxy at https://kie.ai
# KLING_API_KEY is used as a Bearer token for the KIE.ai third-party proxy.
# If using the official Kuaishou endpoint, KLING_API_SECRET is also required
# to generate a short-lived JWT (see lib/video-providers/kling.ts TODO comments).
KLING_API_KEY=
KLING_API_SECRET=

# App URL — used for internal API calls (e.g. http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
