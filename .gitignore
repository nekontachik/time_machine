public/sw.js
public/sw.js.map
public/swe-worker-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE / AI tool configs (may contain API keys in allowed commands)
.claude/
.cursor/
.vscode/

# Local dev scratch files — not for source control
CURSOR_PROMPT_UI_TESTS.md
*.docx
*.audit.md
medium-post.md

# Large media — use Git LFS or external hosting
*.mp4
*.mov
*.avi

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json

# Eval harness output: validated run artifacts (traces, verdicts, reports) ARE
# tracked — they are reference data that calibration depends on (see the
# 2026-07-10 overwrite incident in scripts/eval/langfuse/README.md).
# Only throwaway dry-run output stays ignored:
scripts/eval/out/dryrun/

# Python venv + caches (DeepEval wrapper)
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.deepeval/

# DeepEval wrapper — transient run artifacts (regenerated live)
scripts/eval/deepeval/ts_verdicts.jsonl
scripts/eval/deepeval/prompt_fixtures.jsonl
