{
  "name": "time-machine",
  "version": "0.2.0",
  "private": true,
  "description": "AI-powered alternative history PWA \u2014 explore what-if scenarios for any year from 3000 BCE to 2024 CE",
  "author": "nekontachik",
  "repository": {
    "type": "git",
    "url": "https://github.com/nekontachik/time_machine.git"
  },
  "keywords": [
    "nextjs",
    "typescript",
    "ai",
    "openrouter",
    "fal-ai",
    "alternative-history",
    "threejs",
    "pwa",
    "redis",
    "streaming"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "test:fast": "vitest run --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "test:e2e:desktop": "playwright test --config config/playwright.config.ts --project=chromium",
    "test:e2e:mobile": "playwright test --config config/playwright.config.ts --project=mobile",
    "test:e2e:ui": "playwright test --config config/playwright.config.ts --ui",
    "test:e2e:smoke": "playwright test --config config/playwright.config.ts tests/e2e/smoke.spec.ts",
    "check:server-only": "bash scripts/check-server-only.sh",
    "eval": "npx tsx scripts/eval-harness.ts",
    "test:component": "vitest run --config config/vitest.component.config.ts",
    "redteam:verify": "node redteam/selfcheck.mjs",
    "prepare": "husky",
    "eval:ci": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/ciChecks.ts",
    "eval:traces": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/runTraces.ts",
    "eval:traces:dry": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/runTraces.ts --dry-run",
    "eval:judge": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/runJudge.ts",
    "eval:judge:dry": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/runJudge.ts --dry-run",
    "eval:judge:score": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/runJudge.ts --score-only",
    "eval:judge:recap": "tsx --tsconfig scripts/eval/tsconfig.json scripts/eval/runJudge.ts --judge recap"
  },
  "dependencies": {
    "@fal-ai/client": "^1.9.4",
    "@tavily/core": "^0.7.2",
    "@types/three": "^0.183.1",
    "ioredis": "^5.3.2",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "openai": "^6.32.0",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "three": "^0.183.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "husky": "^9.1.7",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^25.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.0"
  }
}
